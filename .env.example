# ==============================================================
# RESEND EMAIL CONFIGURATION (RECOMMENDED FOR VERCEL & PRODUCTION)
# ==============================================================
# 1. Sign up free at https://resend.com
# 2. Go to "API Keys" -> "Create API Key"
# 3. Paste your key below (starts with re_)
# 4. On Vercel: Add this in Project Settings -> Environment Variables
RESEND_API_KEY=re_your_resend_api_key_here

# Email where you want to receive contact form messages:
RESEND_TO_EMAIL=adehanloyemail@gmail.com

# Sender address (use onboarding@resend.dev for free test domain,
# or your verified domain e.g. Contact <hello@yourdomain.com>)
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ==============================================================
# ADMIN DASHBOARD
# ==============================================================
ADEWALE_ADMIN_PASSWORD=change_me_to_a_strong_password

# ==============================================================
# LEGACY FALLBACKS (Optional)
# ==============================================================
ADEWALE_GMAIL_ADDRESS=adehanloyemail@gmail.com
ADEWALE_GMAIL_APP_PASSWORD=
ADEWALE_FORMSPREE_FORM_ID=
